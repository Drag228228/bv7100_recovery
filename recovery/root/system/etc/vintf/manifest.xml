<!-- Framework manifest for recovery. Without it hwservicemanager does not list
     android.hidl.manager, keystore2's km_compat decides the system is "AIDL only"
     and never reaches the HIDL KeyMaster 4.1 (TrustKernel) -> keystore2 crash loop. -->
<manifest version="2.0" type="framework">
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IServiceManager/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hidl.token</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITokenManager/default</fqname>
    </hal>
</manifest>
